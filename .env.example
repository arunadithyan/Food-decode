# FoodDecode 2.0 configuration. `npm run setup` creates .env.local with a fresh FD_DATA_KEY for you.

# 32-byte key (base64) for AES-256-GCM encryption of health profiles, scans and comparisons at rest.
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FD_DATA_KEY=

# SQLite database file (default .data/fooddecode.db)
# FD_DB_PATH=.data/fooddecode.db

# Only for local testing of `npm start` over plain http (production cookies are Secure by default).
# FD_INSECURE_COOKIES=1

# Optional: self-hosted OCR service (services/ocr-server, RapidOCR with PaddleOCR models).
# Leave empty to offer on-device OCR only. Keys/tokens stay on the server; the browser never sees them.
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=

# Optional: Google Cloud Vision as an alternative online OCR engine (adapter included, not exercised in tests).
GOOGLE_VISION_API_KEY=

# Open Food Facts lookups (barcode / search). Set to 0 to disable all calls to Open Food Facts.
OFF_ENABLED=1
OFF_USER_AGENT=FoodDecode/2.0 (student project; contact via repository)
