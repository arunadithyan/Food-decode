{
  "name": "fooddecode",
  "version": "2.0.0",
  "private": true,
  "description": "FoodDecode 2.0 \u2014 India-first personalised food-label intelligence",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/run-ts.mjs scripts/seed.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "bench:ocr": "node scripts/run-ts.mjs bench/run.ts",
    "typecheck": "tsc --noEmit",
    "ocr-server": "python3 services/ocr-server/server.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
